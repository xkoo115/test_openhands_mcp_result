e_info(pdf_path):\\n    try:\\n        with pdfplumber.open(pdf_path) as pdf:\\n            text = \"\"\\n            for page in pdf.pages:\\n                text += page.extract_text() + \"\\\\n\"\\n            \\n            # Extract company name from filename\\n            company_name = os.path.basename(pdf_path).replace(\\'_quote.pdf\\', \\'\\').replace(\\'_\\', \\' \\').title()\\n            \\n            # Look for price patterns in the text\\n            price_patterns = [\\n                r\\'\\\\$(\\\\d{1,3}(?:,\\\\d{3})*(?:\\\\.\\\\d{2})?)\\',  # $1,234.56 format\\n                r\\'(\\\\d{1,3}(?:,\\\\d{3})*(?:\\\\.\\\\d{2})?)\\\\s*(?:USD|usd)\\',  # 1,234.56 USD format\\n                r\\'Price:\\\\s*\\\\$?(\\\\d{1,3}(?:,\\\\d{3})*(?:\\\\.\\\\d{2})?)\\',  # Price: $1,234.56\\n                r\\'Total:\\\\s*\\\\$?(\\\\d{1,3}(?:,\\\\d{3})*(?:\\\\.\\\\d{2})?)\\',  # Total: $1,234.56\\n                r\\'Amount:\\\\s*\\\\$?(\\\\d{1,3}(?:,\\\\d{3})*(?:\\\\.\\\\d{2})?)\\',  # Amount: $1,234.56\\n            ]\\n            \\n            price = None\\n            for pattern in price_patterns:\\n                matches = re.findall(pattern, text)\\n                if matches:\\n                    # Take the first match and convert to float\\n                    price_str = matches[0].replace(\\',\\', \\'\\')\\n                    try:\\n                        price = float(price_str)\\n                        break\\n                    except ValueError:\\n                        continue\\n            \\n            return company_name, price, text[:500]  # Return first 500 chars for debugging\\n    except Exception as e:\\n        return os.path.basename(pdf_path).replace(\\'_quote.pdf\\', \\'\\').replace(\\'_\\', \\' \\').title(), None, f\"Error: {str(e)}\"\\n\\n# Extract info from all PDFs\\npdf_files = [\\n    \"/workspace/cloudtech_industries_quote.pdf\",\\n    \"/workspace/datacore_enterprise_quote.pdf\", \\n    \"/workspace/netsys_corpora