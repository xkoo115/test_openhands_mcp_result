ing and rewarding your hard work.\n\nPlease note that this new salary will be reflected in your next paycheck. If you have any questions regarding this increase, please do not hesitate to contact the Human Resources Department.\n\nSincerely,\n\nHuman Resources Manager\nThe Agent Company\n\nEmployee Email: [Email]\nAssignment Period: [Start Date] to [End Date]\n\"\"\"\n\n# Create the template file\nwith open('Salary_Increase_MEMO_Template.txt', 'w') as f:\n    f.write(memo_template_content)\n\nprint(\"Created Salary_Increase_MEMO_Template.txt\")\n\n# Upload the template to ownCloud\nprint(\"Uploading Salary_Increase_MEMO_Template.txt to ownCloud...\")\nupload_cmd = [\n    'curl', '-u', 'theagentcompany:theagentcompany',\n    '-T', 'Salary_Increase_MEMO_Template.txt',\n    'http://the-agent-company.com:8092/remote.php/webdav/Documents/Human%20Resources%20Team/Salary_Increase_MEMO.odt'\n]\nresult = subprocess.run(upload_cmd, capture_output=True, text=True)\nif result.returncode == 0:\n    print(\"\u2713 Successfully uploaded Salary_Increase_MEMO.odt template\")\nelse:\n    print(f\"\u2717 Failed to upload template: {result.stderr}\")\n\n# Create salary_increase_notice folder in ownCloud\nprint(\"Creating salary_increase_notice folder in ownCloud...\")\nfolder_cmd = [\n    'curl', '-u', 'theagentcompany:theagentcompany',\n    '-X', 'MKCOL',\n    'http://the-agent-company.com:8092/remote.php/webdav/Documents/Human%20Resources%20Team/salary_increase_notice'\n]\nresult = subprocess.run(folder_cmd, capture_output=True, text=True)\nif result.returncode == 0:\n    print(\"\u2713 Successfully created salary_increase_notice folder\")\nelse:\n    print(f\"Note: Folder may already exist: {result.stderr}\")\n\n# Upload individual memos\nprint(\"Uploading individual salary increase memos...\")\nfor employee in employees:\n    name = employee['Name']\n    filename = f\"salary_increase_notice/{name.replace(' ', '_')}_Salary_Increase_MEMO.txt\"\n    \n    if os.path.exists(filename):\