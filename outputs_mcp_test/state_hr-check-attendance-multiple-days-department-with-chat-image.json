 department\\n    \\'Huang Jie\\': \\'Product/UX\\',\\n    \\'Sophia Rodriguez\\': \\'Product/UX\\',\\n    \\n    # Documentation department\\n    \\'Priya Sharma\\': \\'Documentation\\'\\n}\\n\\n# Function to calculate time difference in hours\\ndef calculate_work_hours(clock_in, clock_out):\\n    try:\\n        # Parse time strings to datetime objects\\n        in_time = datetime.strptime(clock_in.strip(), \\'%H:%M\\')\\n        out_time = datetime.strptime(clock_out.strip(), \\'%H:%M\\')\\n        \\n        # Calculate difference in hours\\n        time_diff = out_time - in_time\\n        hours = time_diff.total_seconds() / 3600\\n        \\n        # Handle cases where clock-out is after midnight (next day)\\n        if hours < 0:\\n            hours += 24\\n            \\n        return hours\\n    except:\\n        return None\\n\\n# Function to check if departure is on-time\\ndef is_on_time_departure(clock_out):\\n    try:\\n        out_time = datetime.strptime(clock_out.strip(), \\'%H:%M\\')\\n        # On-time departure: between 17:30 and 18:00\\n        early_time = datetime.strptime(\\'17:30\\', \\'%H:%M\\')\\n        late_time = datetime.strptime(\\'18:00\\', \\'%H:%M\\')\\n        \\n        return early_time <= out_time <= late_time\\n    except:\\n        return False\\n\\n# Function to check if arrival is late\\ndef is_late_arrival(clock_in):\\n    try:\\n        in_time = datetime.strptime(clock_in.strip(), \\'%H:%M\\')\\n        late_time = datetime.strptime(\\'09:00\\', \\'%H:%M\\')\\n        \\n        return in_time > late_time\\n    except:\\n        return False\\n\\n# Apply calculations to the dataframe\\ndf[\\'Work_Hours\\'] = df.apply(lambda row: calculate_work_hours(row[\\'Clock-in\\'], row[\\'Clock-out\\']), axis=1)\\ndf[\\'On_Time_Departure\\'] = df[\\'Clock-out\\'].apply(is_on_time_departure)\\ndf[\\'Late_Arrival\\'] = df[\\'Clock-in\\'].apply(is_late_arrival)\\n\\n# Add department information\\ndf[\\'Department\\'] = df[\\'Name\\'].ma