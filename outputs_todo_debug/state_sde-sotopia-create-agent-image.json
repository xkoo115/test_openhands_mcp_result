t ScriptBackground\n\n\nasync def ainput(prompt: str = \"\") -> str:\n    with ThreadPoolExecutor(1, \"ainput\") as executor:\n        return (\n            await asyncio.get_event_loop().run_in_executor(executor, input, prompt)\n        ).rstrip()\n\n\nclass NonVerbalAgent(BaseAgent[Observation, AgentAction]):\n    \"\"\"\n    An agent that can only issue non-verbal communication.\n    This agent is based on LLMAgent but restricted to non-verbal actions only.\n    \"\"\"\n    \n    def __init__(\n        self,\n        agent_name: str | None = None,\n        uuid_str: str | None = None,\n        agent_profile: AgentProfile | None = None,\n        model_name: str = \"gpt-4o-mini\",\n        script_like: bool = False,\n    ) -> None:\n        super().__init__(\n            agent_name=agent_name,\n            uuid_str=uuid_str,\n            agent_profile=agent_profile,\n        )\n        self.model_name = model_name\n        self.script_like = script_like\n\n    @property\n    def goal(self) -> str:\n        if self._goal is not None:\n            return self._goal\n        else:\n            raise Exception(\"Goal is not set.\")\n\n    @goal.setter\n    def goal(self, goal: str) -> None:\n        self._goal = goal\n\n    def act(\n        self,\n        _obs: Observation,\n    ) -> AgentAction:\n        raise Exception(\"Sync act method is deprecated. Use aact instead.\")\n\n    async def aact(self, obs: Observation) -> AgentAction:\n        self.recv_message(\"Environment\", obs)\n\n        if self._goal is None:\n            self._goal = await agenerate_goal(\n                self.model_name,\n                background=self.inbox[0][\n                    1\n                ].to_natural_language(),  # Only consider the first message for now\n            )\n\n        if len(obs.available_actions) == 1 and \"none\" in obs.available_actions:\n            return AgentAction(action_type=\"none\", argument=\"\")\n        else:\n            # Filter available actions to only allow non-verbal communication\n            non_verbal_actions = [action for action in obs.available_actions \n                                if action == \"non-verbal communication\"]\n            \n            # If no non-verbal actions are available, use \"none\"\n            if not non_verbal_actions:\n                return AgentAction(action_type=\"none\", argument=\"\")\n            \n            action = await agenerate_action(\n                self.model_name,\n                history=\"\\n\".join(f\"{y.to_natural_language()}\" for x, y in self.inbox),\n                turn_number=obs.turn_number,\n                action_types=non_verbal_actions,\n                agent=self.agent_name,\n                goal=self.goal,\n                script_like=self.script_like,\n            )\n            # Temporary fix for mixtral-moe model for incorrect generation format\n            if \"Mixtral-8x7B-Instruct-v0.1\" in self.model_name:\n                current_agent = self.agent_name\n                if f\"{current_agent}:\" in action.argument:\n                    print(\"Fixing Mixtral's generation format\")\n                    action.argument = action.argument.replace(f\"{current_agent}: \", \"\")\n                elif f\"{current_agent} said:\" in action.argument:\n                    print(\"Fixing Mixtral's generation format\")\n                    action.argument = action.argument.replace(\n                        f\"{current_agent} said: \", \"\"\n                    )\n\n            return action\n\n\nclass NonVerbalScriptWritingAgent(NonVerbalAgent):\n    \"\"\"\n    A script writing agent that can only issue non-verbal communication.\n    \"\"\"\n    \n    def __init__(\n        self,\n        agent_name: str | None = None,\n        uuid_str: str | None = None,\n        agent_profile: AgentProfile | None = None,\n        model_name: str = \"gpt-4o-mini\",\n        agent_names: list[str] = [],\n        background: ScriptBackground | None = None,\n    ) -> None:\n        super().__init__(\n            agent_name=agent_name,\n            uuid_str=uuid_str,\n            agent_profile=agent_profile,\n        )\n        self.model_name = model_name\n        self.agent_names = agent_names\n        assert background is not None, \"background cannot be None\"\n        self.background = background\n\n    async def aact(self, obs: Observation) -> AgentAction:\n        self.recv_message(\"Environment\", obs)\n        message_to_compose = [y for idx, (x, y) in enumerate(self.inbox) if idx != 0]\n\n        history = \"\\n\".join(f\"{y.to_natural_language()}\" for y in message_to_compose)\n\n        action, prompt = await agenerate_script(\n            model_name=self.model_name,\n            background=self.background,\n            agent_names=self.agent_names,\n            history=history,\n            agent_name=self.agent_name,\n            single_step=True,\n        )\n        returned_action = cast(AgentAction, action[1][0][1])\n        \n        # Ensure the returned action is non-verbal\n        if returned_action.action_type != \"non-verbal communication\":\n            returned_action = AgentAction(\n                action_type=\"non-verbal communication\", \n                argument=returned_action.argument\n            )\n            \n        return returned_action\n\n```\n, FileEditObservation(content='File created successfully at: /workspace/sotopia/sotopia/agents/nonverbal_agent.py', path='/workspace/sotopia/sotopia/agents/nonverbal_agent.py', prev_exist=False, old_content=None, new_content=None, observation=<ObservationType.EDIT: 'edit'>, impl_source='oh_aci', diff='--- /workspace/sotopia/sotopia/agents/nonverbal_agent.py\\n+++ /workspace/sotopia/sotopia/agents/nonverbal_agent.py\\n@@ -0,0 +1,3 @@\\n+import asyncio\\n+from concurrent.futures import ThreadPoolExecutor\\n+from typing import cast\\n@@ -1,0 +5,153 @@\\n+from sotopia.agents import BaseAgent\\n+from sotopia.database import AgentProfile\\n+from sot