m filename\\n    company_name = filename.replace(\\'_quote.pdf\\', \\'\\').replace(\\'_\\', \\' \\').title()\\n    \\n    # Extract price - look for dollar amounts\\n    price_pattern = r\\'\\\\$(\\\\d+(?:,\\\\d+)*(?:\\\\.\\\\d+)?)\\'\\n    prices = re.findall(price_pattern, text)\\n    \\n    # Take the largest price found (likely the total price)\\n    price = None\\n    if prices:\\n        # Convert to float and take the max\\n        price_values = [float(p.replace(\\',\\', \\'\\')) for p in prices]\\n        price = max(price_values)\\n    \\n    return company_name, price\\n\\ndef check_requirements_improved(text):\\n    # Check CPU cores - look for patterns like \"30 cores\" or \"31 cores\"\\n    cpu_pattern = r\\'(\\\\d+)\\\\s*[Cc]ores?\\'\\n    cpu_matches = re.findall(cpu_pattern, text)\\n    cpu_cores = 0\\n    if cpu_matches:\\n        cpu_cores = max([int(m) for m in cpu_matches])\\n    \\n    # Check RAM - look for patterns like \"768GB\", \"512GB\", \"384GB\"\\n    ram_pattern = r\\'(\\\\d+)\\\\s*[Gg][Bb]\\'\\n    ram_matches = re.findall(ram_pattern, text)\\n    ram_gb = 0\\n    if ram_matches:\\n        # Filter to reasonable RAM sizes (likely > 100GB for servers)\\n        ram_values = [int(m) for m in ram_matches if int(m) > 100]\\n        if ram_values:\\n            ram_gb = max(ram_values)\\n    \\n    # Check SSDs - look for patterns like \"8x 3.84TB\", \"4x 1.92TB\", \"6x 1.92TB\"\\n    ssd_pattern = r\\'(\\\\d+)\\\\s*x\\\\s*1\\\\.92\\\\s*[Tt][Bb]\\'\\n    ssd_matches = re.findall(ssd_pattern, text)\\n    ssd_count = 0\\n    if ssd_matches:\\n        ssd_count = max([int(m) for m in ssd_matches])\\n    \\n    # Check warranty - look for patterns like \"4 Years\", \"5 Years\", \"3 Years\"\\n    warranty_pattern = r\\'(\\\\d+)\\\\s*[Yy]ears?\\'\\n    warranty_matches = re.findall(warranty_pattern, text)\\n    warranty_years = 0\\n    if warranty_matches:\\n        # Filter to reasonable warranty periods (likely 1-10 years)\\n        warranty_values = [int(m) for m in warranty_matches if 1 <= int(m) <= 10]\\n        if warranty_values:\\n            warranty_years = max(warranty_values)\\n    \\n    print(f\"  CPU cores: {cpu_cores} (required: >=28)\")\\n    print(f\"  RAM: {ram_gb}GB (required: >=512GB)\")\\n    print(f\"  SSDs: {ssd_count}x 1.92TB (required: >=6x)\")\\n    print(f\"  Warranty: {warranty_years} years (required: >=4 years)\")\\n    \\n    # Check if all requirements are met\\n    meets_cpu = cpu_cores >= 28\\n    meets_ram = ram_gb >= 512\\n    meets_ssd = ssd_count >= 6\\n    meets_warranty = warranty_years >= 4\\n    \\n    return meets_cpu and meets_ram and meets_ssd and meets_warranty\\n\\n# Process all quote files with improved analysis\\nvalid_quotes = []\\n\\npdf_files = [\\n    \\'cloudtech_industries_quote.pdf\\',\\n    \\'datacore_enterprise_quote.pdf\\', \\n    \\'netsys_corporation_quote.pdf\\',\\n    \\'servermaster_systems_quote.pdf\\',\\n    \\'techpro_solutions_quote.pdf\\'\\n]\\n\\nfor pdf_file in pdf_files:\\n    print(f\"Processing {pdf_file}...\")\\n    text = extract_text_from_pdf(pdf_file)\\n    \\n    if text:\\n        company_name, price = extract_quote_info(text, pdf_file)\\n        meets_requirements = check_requirements_improved(text)\\n        \\n        print(f\"  Company: {company_name}\")\\n        print(f\"  Price: ${price if price else \\'Not found\\'}\")\\n        print(f\"  Meets requirements: {meets_requirements}\")\\n        print()\\n        \\n        if meets_requirements and price:\\n            valid_quotes.append({\\n                \\'name\\': company_name,\\n                \\'price\\': price\\n            })\\n\\nprint(f\"Found {len(valid_quotes)} valid quotes that meet requirements\")\\n\\n\\n\\n\\n\\n\\n', thought='Now I understand the structure better. Let me create a more accurate analysis that properly checks the requirements based on the actual content format.', include_extra=True, action=<ActionType.RUN_IPYTHON: 'run_ipython'>, confirm